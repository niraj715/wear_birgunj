{
  "name": "wear-birgunj",
  "version": "1.0.0",
  "private": true,
  "description": "Wear Birgunj — Production-Grade Multivendor E-Commerce Marketplace",
  "type": "module",
  "scripts": {
    "db:migrate": "tsx apps/api/src/db/cli-migrate.ts",
    "db:seed": "tsx apps/api/src/db/cli-seed.ts",
    "db:backup-drill": "tsx apps/api/src/db/cli-backup-drill.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run apps/api/test/db-foundation.spec.ts",
    "test:api": "vitest run apps/api/test/api-e2e-journeys.spec.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@noble/hashes": "^1.7.1",
    "@tanstack/react-query": "^5.66.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
