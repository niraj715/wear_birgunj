# Wear Birgunj — Environment Configuration Example (NEVER commit real .env secrets)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL connection string (when omitted in local dev, embedded PostgreSQL 16 at ./data/pgdata is used)
# DATABASE_URL=postgresql://wear_birgunj_runtime:change_me@localhost:5432/wear_birgunj

# Security & Session Secrets (Replace in staging/production via Secret Manager)
SESSION_SECRET=dev-only-replace-in-prod-session-secret-32b
CSRF_SECRET=dev-only-replace-in-prod-csrf-secret-32b
ESEWA_WEBHOOK_SECRET=dev-only-esewa-hmac-secret-key
KHALTI_WEBHOOK_SECRET=dev-only-khalti-hmac-secret-key
CARRIER_WEBHOOK_SECRET=dev-only-carrier-hmac-secret-key

# Cloudinary Product Media (Server-side only — DO NOT prefix with VITE_ or expose to client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini Customer Support API (Server-side only — DO NOT prefix with VITE_ or expose to client)
GEMINI_API_KEY=

